rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOwnerUserId() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function resourceOwnedByUser() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read, delete: if resourceOwnedByUser();
      allow create: if hasOwnerUserId();
      allow update: if resourceOwnedByUser() && hasOwnerUserId();
    }

    match /achievements/{achievementId} {
      allow read, delete: if resourceOwnedByUser();
      allow create: if hasOwnerUserId();
      allow update: if resourceOwnedByUser() && hasOwnerUserId();
    }

    match /challenges/{challengeId} {
      allow read, delete: if resourceOwnedByUser();
      allow create: if hasOwnerUserId();
      allow update: if resourceOwnedByUser() && hasOwnerUserId();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
