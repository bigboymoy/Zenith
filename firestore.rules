rules_version = '2';
// Zenith Firestore rules. Per-collection rules documented below.
// Assumptions: client writes with validated auth; no server-side admin SDK; rate-limiting not enforced
// (recommend Firebase App Check and Console quotas for production).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOwnerUserId() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function resourceOwnedByUser() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // True if the signed-in user follows the given author (for followers visibility).
    function follows(authorId) {
      return isSignedIn() && exists(/databases/$(database)/documents/follows/$(request.auth.uid)_$(authorId));
    }

    // Activities: read if owner, or visibility is public, or visibility is followers and requester follows author.
    // Default visibility 'public' for backward compatibility with activities created before privacy fields existed.
    function canReadActivity(activityData) {
      return isOwner(activityData.userId)
        || activityData.get('visibility', 'public') == 'public'
        || (activityData.get('visibility', 'public') == 'followers' && follows(activityData.userId));
    }

    // ── users: read by any signed-in user (public profile for feed/profile); write only owner ──
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /oneRepMax/{exerciseId} {
        allow read, write: if isOwner(userId);
      }
      match /nutrition/{date} {
        allow read, write: if isOwner(userId);
      }
      // Integration tokens (Strava, etc.) — owner only; not exposed in profile
      match /integrations/{integrationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── activities: read by owner or by visibility (public / followers); write by owner only ──
    match /activities/{activityId} {
      allow read: if isSignedIn() && canReadActivity(resource.data);
      allow delete: if resourceOwnedByUser();
      allow create: if hasOwnerUserId();
      allow update: if resourceOwnedByUser() && hasOwnerUserId();
    }

    match /achievements/{achievementId} {
      allow read, delete: if resourceOwnedByUser();
      allow create: if hasOwnerUserId();
      allow update: if resourceOwnedByUser() && hasOwnerUserId();
    }

    match /challenges/{challengeId} {
      allow read, delete: if resourceOwnedByUser();
      allow create: if hasOwnerUserId();
      allow update: if resourceOwnedByUser() && hasOwnerUserId();
    }

    // ── feed: fan-out of activities to followers; read by follower, create by activity author ──
    match /feed/{feedId} {
      allow read: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── follows: users can only create/delete where followerId == auth.uid; read for building follow graph ──
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // ── kudos: read if requester can read the activity; write own kudos only ──
    match /kudos/{kudoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── comments: read if requester can read activity (simplified: any signed-in for list; activity read checked in app if needed); write own ──
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── clubs: members and public (isPublic) can read; owner can update; join/leave: only memberIds change, add/remove self ──
    match /clubs/{clubId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.get('memberIds', [])
        || resource.data.get('isPublic', false) == true
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.auth.uid in request.resource.data.get('memberIds', [])
            && !(request.auth.uid in resource.data.get('memberIds', [])))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.auth.uid in resource.data.get('memberIds', [])
            && !(request.auth.uid in request.resource.data.get('memberIds', []))
            && resource.data.ownerId != request.auth.uid)
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── segments: read public (all); write only creator ──
    match /segments/{segmentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ── segmentResults: read for leaderboard; write own results only ──
    match /segmentResults/{resultId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── workoutTemplates: owner only ──
    match /workoutTemplates/{templateId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
